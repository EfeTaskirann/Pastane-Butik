# ===========================================
# PASTANE — Staging Environment Template
# ===========================================
# `.env.staging` olarak kopyala, değerleri doldur.
# `.env.staging` GIT'e eklenmemeli (.gitignore'da).
#
# docker-compose.staging.yml bu dosyayı `--env-file .env.staging` ile okur.
# ===========================================

# Application
APP_NAME="Tatlı Düşler (Staging)"
APP_ENV=staging
APP_DEBUG=false
APP_URL=http://staging.tatlidusler.local:8090
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr

# Port overrides (prod ile çakışmasın)
STAGING_APP_PORT=8090
STAGING_DB_PORT=33307
STAGING_REDIS_PORT=6380
STAGING_PROMETHEUS_PORT=9090

# Database
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=pastane_staging
DB_USERNAME=pastane_staging
DB_PASSWORD=GENERATE_STAGING_DB_PASSWORD
DB_ROOT_PASSWORD=GENERATE_STAGING_ROOT_PASSWORD
DB_CHARSET=utf8mb4

# Security (staging için ayrı key — prod değeri ile aynı olmasın)
APP_KEY=base64:GENERATE_A_STAGING_32_CHAR_RANDOM_KEY
JWT_SECRET=GENERATE_A_STAGING_JWT_SECRET
SESSION_LIFETIME=3600
CSRF_TOKEN_LIFETIME=3600
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900

# Admin
ADMIN_EMAIL=staging-admin@tatlidusler.local

# Upload Settings
FILESYSTEM_DISK=local
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# WhatsApp Integration
WHATSAPP_NUMBER=905551234567

# Rate Limiting
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60

# Logging
LOG_CHANNEL=file
LOG_LEVEL=info
LOG_PATH=storage/logs

# Cache
CACHE_DRIVER=file
CACHE_PATH=storage/cache

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Payment Gateway (staging → sandbox)
ODEME_GATEWAY=test
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Mail (staging → Mailtrap / ayrı sandbox)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@staging.tatlidusler.local
MAIL_FROM_NAME="${APP_NAME}"

# SMS Gateway (staging → log driver, gerçek SMS yollama)
SMS_DRIVER=log
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=TATLIDUSLER

# Error Tracking — Sentry (staging'de sample rate daha yüksek)
SENTRY_DSN=https://YOUR_STAGING_PUBLIC_KEY@o00000.ingest.sentry.io/0000000
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.5

# Observability — Prometheus metrics endpoint
# Prod ile AYNI olmasın; staging için ayrı token üret.
METRICS_TOKEN=GENERATE_STAGING_METRICS_TOKEN
HEALTH_TOKEN=GENERATE_STAGING_HEALTH_TOKEN
