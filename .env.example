# ===========================================
# PASTANE - Environment Configuration
# ===========================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun
# .env dosyası GIT'e eklenmemelidir!

# Application
APP_NAME="Tatlı Düşler"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/pastane
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr

# Database
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=pastane_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Security
APP_KEY=base64:GENERATE_A_32_CHAR_RANDOM_KEY_HERE
JWT_SECRET=GENERATE_A_SECURE_JWT_SECRET_HERE
SESSION_LIFETIME=3600
CSRF_TOKEN_LIFETIME=3600
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900

# Admin
ADMIN_EMAIL=admin@example.com

# Upload Settings
FILESYSTEM_DISK=local
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# WhatsApp Integration
WHATSAPP_NUMBER=905551234567

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Logging
LOG_CHANNEL=file
LOG_LEVEL=debug
LOG_PATH=storage/logs

# Cache
CACHE_DRIVER=file
CACHE_PATH=storage/cache

# Redis (opsiyonel — cache/session için)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Payment Gateway
ODEME_GATEWAY=test
IYZICO_ENABLED=false
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# IyzicoService P2-18 ile uyumlu key adı (eski IYZICO_SECRET_KEY ile her ikisi de okunur)
IYZICO_SECRET=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Webhook signature secret (HMAC-SHA256). Boş bırakılırsa IYZICO_SECRET kullanılır.
IYZICO_WEBHOOK_SECRET=

# Mail (SMTP)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# SMS Gateway (future — NetGSM / İletiMerkezi / Twilio vb.)
SMS_DRIVER=log
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=TATLIDUSLER

# Error Tracking (Sentry)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Observability — Prometheus metrics endpoint
# `openssl rand -hex 32` ile güvenli değer üret. Boş bırakılırsa /api/metrics devre dışı (503).
METRICS_TOKEN=GENERATE_A_SECURE_METRICS_TOKEN_HERE

# Health check metrics/errors (Sprint 1'de eklendi — sensitive alt-endpoint token'ı)
HEALTH_TOKEN=GENERATE_A_SECURE_HEALTH_TOKEN_HERE
