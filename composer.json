{
    "name": "pastane/butik-pasta",
    "description": "Tatlı Düşler - Butik Pasta & Tatlı Sipariş Sistemi",
    "type": "project",
    "license": "proprietary",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Pastane Team",
            "email": "info@example.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Pastane\\": "src/",
            "Pastane\\Tests\\": "tests/"
        },
        "classmap": [
            "includes/JWT.php",
            "includes/RateLimiter.php",
            "includes/SecurityAudit.php",
            "includes/TwoFactorAuth.php",
            "includes/PasswordPolicy.php",
            "includes/Logger.php",
            "includes/Cache.php",
            "includes/Migration.php",
            "includes/HealthCheck.php",
            "includes/EmailService.php",
            "includes/SmsService.php",
            "includes/Metrics.php",
            "includes/SvgSanitizer.php"
        ],
        "files": [
            "includes/helpers.php",
            "includes/asset.php",
            "includes/i18n.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Pastane\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "phpstan": "phpstan analyse --no-progress",
        "phpcs": "phpcs --standard=PSR12 src/ includes/",
        "phpcbf": "phpcbf --standard=PSR12 src/ includes/",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "lint": [
            "@phpcs",
            "@phpstan",
            "@cs-check"
        ],
        "fix": [
            "@phpcbf",
            "@cs-fix"
        ],
        "captainhook:install": "captainhook install --ansi -f",
        "post-install-cmd": [
            "@php -r \"if (file_exists('vendor/bin/captainhook')) { passthru('vendor/bin/captainhook install -f -s'); }\""
        ]
    },
    "suggest": {
        "friendsofphp/php-cs-fixer": "PSR-12 + proje kodlama standardı (composer require --dev friendsofphp/php-cs-fixer)",
        "captainhook/captainhook": "Git pre-commit/commit-msg hook'ları (composer require --dev captainhook/captainhook)",
        "captainhook/plugin-composer": "CaptainHook composer auto-install entegrasyonu"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
